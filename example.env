# Optional defaults for fetchwin. Copy to .env and `source` it, or export these in your shell.
# Every value can also be given as a command-line flag; flags win.

# arm64 | x64
FETCHWIN_ARCH=arm64
# consumer (retail Home/Pro/Education) | business (volume-licensed Enterprise/Education/Pro)
FETCHWIN_CHANNEL=consumer
# Language code as used by Microsoft, e.g. en-us, en-gb, de-de
FETCHWIN_LANG=en-us
# 11 | 10
FETCHWIN_WINDOWS=11
# Where ISOs are written
FETCHWIN_OUT=.
# Optional catalog override: https URL or local products.cab / products.xml
FETCHWIN_CATALOG=

# Optional tool overrides (names or paths)
# FETCHWIN_WIMLIB=wimlib-imagex
# FETCHWIN_MKISOFS=mkisofs
# FETCHWIN_BSDTAR=bsdtar
# FETCHWIN_CABEXTRACT=cabextract
